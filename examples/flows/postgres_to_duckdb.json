{
  "name": "pg_to_duckdb",
  "wire_format": "arrow",
  "source": {
    "name": "pg-source",
    "type": "postgres",
    "options": {
      "dsn": "postgres://user:pass@localhost:5432/app?sslmode=disable",
      "slot": "wallaby_slot",
      "publication": "wallaby_pub",
      "batch_size": "500",
      "batch_timeout": "1s",
      "status_interval": "10s",
      "create_slot": "true",
      "format": "arrow"
    }
  },
  "destinations": [
    {
      "name": "duckdb-out",
      "type": "duckdb",
      "options": {
        "dsn": "./data/warehouse.duckdb"
      }
    }
  ],
  "config": {
    "ack_policy": "all",
    "table_mappings": {"version": 2, "destinations": [{"destination": "duckdb-out", "future_tables": {"action": "include", "target_schema": "{{ .Schema }}", "target_table": "{{ .Table }}", "future_columns": {"action": "include", "target_column": "{{ .Column }}"}, "write": {"mode": "append", "key_columns": []}}, "tables": []}]}
  }
}

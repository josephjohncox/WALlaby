{
  "config": {
    "ack_policy": "all",
    "table_mappings": {
      "destinations": [
        {
          "destination": "webhook",
          "future_tables": {
            "action": "include",
            "future_columns": {
              "action": "include",
              "target_column": "{{ .Column }}"
            },
            "target_schema": "{{ .Schema }}",
            "target_table": "{{ .Table }}",
            "write": {
              "key_columns": [],
              "mode": "append"
            }
          },
          "tables": []
        }
      ],
      "version": 2
    }
  },
  "destinations": [
    {
      "http": {
        "format": "WIRE_FORMAT_JSON",
        "headers": {
          "authorization": "Bearer token123"
        },
        "method": "POST",
        "retry": {
          "backoff_base": "0.200s",
          "backoff_factor": 2,
          "backoff_max": "5s",
          "max_retries": 5
        },
        "url": "https://api.example.com/ingest"
      },
      "name": "webhook"
    }
  ],
  "name": "pg_to_http_full_toast",
  "source": {
    "name": "pg-source",
    "postgres_source": {
      "mode": "POSTGRES_SOURCE_MODE_CDC",
      "batch_size": 500,
      "batch_timeout": "1s",
      "connection": {
        "dsn": "postgres://user:pass@localhost:5432/app?sslmode=disable"
      },
      "create_slot": true,
      "format": "WIRE_FORMAT_JSON",
      "publication": "wallaby_pub",
      "publication_schemas": [
        "public"
      ],
      "slot": "wallaby_slot",
      "status_interval": "10s",
      "toast_fetch": "TOAST_FETCH_MODE_FULL"
    }
  },
  "wire_format": "json"
}

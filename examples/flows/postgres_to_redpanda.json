{
  "config": {
    "ack_policy": "all",
    "table_mappings": {
      "destinations": [
        {
          "destination": "redpanda-out",
          "future_tables": {
            "action": "include",
            "future_columns": {
              "action": "include",
              "target_column": "{{ .Column }}"
            },
            "target_schema": "{{ .Schema }}",
            "target_table": "{{ .Table }}",
            "write": {
              "key_columns": [],
              "mode": "append"
            }
          },
          "tables": []
        }
      ],
      "version": 2
    }
  },
  "destinations": [
    {
      "name": "redpanda-out",
      "redpanda": {
        "kafka": {
          "acks": "KAFKA_ACKS_ALL",
          "brokers": [
            "localhost:9092"
          ],
          "compression": "COMPRESSION_LZ4",
          "format": "WIRE_FORMAT_ARROW",
          "topic": "wallaby.cdc"
        }
      }
    }
  ],
  "name": "pg_to_redpanda",
  "source": {
    "name": "pg-source",
    "postgres_source": {
      "mode": "POSTGRES_SOURCE_MODE_CDC",
      "batch_size": 500,
      "batch_timeout": "1s",
      "connection": {
        "dsn": "postgres://user:pass@localhost:5432/app?sslmode=disable"
      },
      "create_slot": true,
      "format": "WIRE_FORMAT_ARROW",
      "publication": "wallaby_pub",
      "publication_schemas": [
        "public"
      ],
      "slot": "wallaby_slot",
      "status_interval": "10s"
    }
  },
  "wire_format": "arrow"
}

{
  "config": {
    "ack_policy": "all",
    "table_mappings": {
      "destinations": [
        {
          "destination": "grpc_ingest",
          "future_tables": {
            "action": "include",
            "future_columns": {
              "action": "include",
              "target_column": "{{ .Column }}"
            },
            "target_schema": "{{ .Schema }}",
            "target_table": "{{ .Table }}",
            "write": {
              "key_columns": [],
              "mode": "append"
            }
          },
          "tables": []
        }
      ],
      "version": 2
    }
  },
  "destinations": [
    {
      "grpc": {
        "endpoint": "localhost:9090",
        "format": "WIRE_FORMAT_JSON",
        "metadata": {
          "x-tenant": "demo"
        },
        "retry": {
          "backoff_base": "0.200s",
          "backoff_factor": 2,
          "backoff_max": "5s",
          "max_retries": 3
        },
        "timeout": "10s",
        "tls": {
          "insecure": true
        }
      },
      "name": "grpc_ingest"
    }
  ],
  "name": "pg_to_grpc",
  "source": {
    "name": "pg-source",
    "postgres_source": {
      "mode": "POSTGRES_SOURCE_MODE_CDC",
      "batch_size": 500,
      "batch_timeout": "1s",
      "connection": {
        "dsn": "postgres://user:pass@localhost:5432/app?sslmode=disable"
      },
      "create_slot": true,
      "format": "WIRE_FORMAT_JSON",
      "publication": "wallaby_pub",
      "publication_schemas": [
        "public"
      ],
      "slot": "wallaby_slot",
      "status_interval": "10s"
    }
  },
  "wire_format": "json"
}

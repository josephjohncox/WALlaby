{
  "name": "pg_to_s3",
  "wire_format": "parquet",
  "source": {
    "name": "pg-source",
    "type": "postgres",
    "options": {
      "dsn": "postgres://user:pass@localhost:5432/app?sslmode=disable",
      "slot": "wallaby_slot",
      "publication": "wallaby_pub",
      "batch_size": "1000",
      "batch_timeout": "2s",
      "status_interval": "10s",
      "create_slot": "true",
      "format": "parquet"
    }
  },
  "destinations": [
    {
      "name": "s3-out",
      "type": "s3",
      "options": {
        "bucket": "my-wallaby-bucket",
        "prefix": "cdc/",
        "region": "us-east-1",
        "format": "parquet",
        "compression": "gzip",
        "partition_by": "region,created_at:day"
      }
    }
  ],
  "config": {
    "ack_policy": "all",
    "table_mappings": {"version": 1, "destinations": [{"destination": "s3-out", "future_tables": {"action": "include", "target_schema": "{schema}", "target_table": "{table}", "future_columns": {"action": "include", "target_column": "{column}"}, "write": {"mode": "append", "key_columns": []}}, "tables": []}]}
  }
}

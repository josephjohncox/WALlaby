{
  "config": {
    "ack_policy": "all",
    "table_mappings": {
      "destinations": [
        {
          "destination": "s3-out",
          "future_tables": {
            "action": "include",
            "future_columns": {
              "action": "include",
              "target_column": "{{ .Column }}"
            },
            "target_schema": "{{ .Schema }}",
            "target_table": "{{ .Table }}",
            "write": {
              "key_columns": [],
              "mode": "append"
            }
          },
          "tables": []
        }
      ],
      "version": 2
    }
  },
  "destinations": [
    {
      "name": "s3-out",
      "s3": {
        "bucket": "my-wallaby-bucket",
        "compression": "COMPRESSION_GZIP",
        "format": "WIRE_FORMAT_PARQUET",
        "partition_by": [
          "region",
          "created_at:day"
        ],
        "prefix": "cdc/",
        "region": "us-east-1"
      }
    }
  ],
  "name": "pg_to_s3",
  "source": {
    "name": "pg-source",
    "postgres_source": {
      "mode": "POSTGRES_SOURCE_MODE_CDC",
      "batch_size": 1000,
      "batch_timeout": "2s",
      "connection": {
        "dsn": "postgres://user:pass@localhost:5432/app?sslmode=disable"
      },
      "create_slot": true,
      "format": "WIRE_FORMAT_PARQUET",
      "publication": "wallaby_pub",
      "publication_schemas": [
        "public"
      ],
      "slot": "wallaby_slot",
      "status_interval": "10s"
    }
  },
  "wire_format": "parquet"
}

{
  "config": {
    "ack_policy": "primary",
    "failure_mode": "hold_slot",
    "give_up_policy": "on_retry_exhaustion",
    "primary_destination": "kafka-out",
    "table_mappings": {
      "destinations": [
        {
          "destination": "kafka-out",
          "future_tables": {
            "action": "include",
            "future_columns": {
              "action": "include",
              "target_column": "{{ .Column }}"
            },
            "target_schema": "{{ .Schema }}",
            "target_table": "{{ .Table }}",
            "write": {
              "key_columns": [],
              "mode": "append"
            }
          },
          "tables": []
        },
        {
          "destination": "http-out",
          "future_tables": {
            "action": "include",
            "future_columns": {
              "action": "include",
              "target_column": "{{ .Column }}"
            },
            "target_schema": "{{ .Schema }}",
            "target_table": "{{ .Table }}",
            "write": {
              "key_columns": [],
              "mode": "append"
            }
          },
          "tables": []
        }
      ],
      "version": 2
    }
  },
  "destinations": [
    {
      "kafka": {
        "acks": "KAFKA_ACKS_ALL",
        "brokers": [
          "localhost:9092"
        ],
        "compression": "COMPRESSION_LZ4",
        "format": "WIRE_FORMAT_JSON",
        "topic": "wallaby.cdc"
      },
      "name": "kafka-out"
    },
    {
      "http": {
        "format": "WIRE_FORMAT_JSON",
        "headers": {
          "authorization": "Bearer token123"
        },
        "method": "POST",
        "url": "https://api.example.com/ingest"
      },
      "name": "http-out"
    }
  ],
  "name": "pg_to_kafka_http_primary",
  "source": {
    "name": "pg-source",
    "postgres_source": {
      "mode": "POSTGRES_SOURCE_MODE_CDC",
      "batch_size": 500,
      "batch_timeout": "1s",
      "connection": {
        "dsn": "postgres://user:pass@localhost:5432/app?sslmode=disable"
      },
      "create_slot": true,
      "format": "WIRE_FORMAT_JSON",
      "publication": "wallaby_pub",
      "publication_schemas": [
        "public"
      ],
      "slot": "wallaby_slot",
      "status_interval": "10s"
    }
  },
  "wire_format": "json"
}

{
  "config": {
    "ack_policy": "all",
    "table_mappings": {
      "destinations": [
        {
          "destination": "snowpipe-out",
          "future_tables": {
            "action": "include",
            "future_columns": {
              "action": "include",
              "target_column": "{{ .Column }}"
            },
            "target_schema": "{{ .Schema }}",
            "target_table": "{{ .Table }}",
            "write": {
              "key_columns": [],
              "mode": "append"
            }
          },
          "tables": []
        }
      ],
      "version": 2
    }
  },
  "destinations": [
    {
      "name": "snowpipe-out",
      "snowpipe": {
        "auto_ingest": true,
        "copy_on_write": false,
        "dsn": "user@account/db/schema?authenticator=snowflake_jwt&ocspFailOpen=false&role=WALLABY_EXECUTION",
        "format": "WIRE_FORMAT_PARQUET",
        "stage": "@my_external_stage",
        "stage_path": "wallaby/"
      }
    }
  ],
  "name": "pg_to_snowpipe",
  "source": {
    "name": "pg-source",
    "postgres_source": {
      "mode": "POSTGRES_SOURCE_MODE_CDC",
      "batch_size": 1000,
      "batch_timeout": "2s",
      "connection": {
        "dsn": "postgres://user:pass@localhost:5432/app?sslmode=disable"
      },
      "create_slot": true,
      "format": "WIRE_FORMAT_PARQUET",
      "publication": "wallaby_pub",
      "publication_schemas": [
        "public"
      ],
      "slot": "wallaby_slot",
      "status_interval": "10s"
    }
  },
  "wire_format": "parquet"
}

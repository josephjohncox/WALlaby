{
  "name": "pg_to_snowpipe",
  "wire_format": "parquet",
  "source": {
    "name": "pg-source",
    "type": "postgres",
    "options": {
      "dsn": "postgres://user:pass@localhost:5432/app?sslmode=disable",
      "slot": "wallaby_slot",
      "publication": "wallaby_pub",
      "batch_size": "1000",
      "batch_timeout": "2s",
      "status_interval": "10s",
      "create_slot": "true",
      "format": "parquet"
    }
  },
  "destinations": [
    {
      "name": "snowpipe-out",
      "type": "snowpipe",
      "options": {
        "dsn": "user:pass@account/db/schema?role=SYSADMIN",
        "stage": "@my_external_stage",
        "stage_path": "wallaby/",
        "format": "parquet",
        "auto_ingest": "true",
        "copy_on_write": "false"
      }
    }
  ],
  "config": {
    "ack_policy": "all",
    "table_mappings": {"version": 2, "destinations": [{"destination": "snowpipe-out", "future_tables": {"action": "include", "target_schema": "{{ .Schema }}", "target_table": "{{ .Table }}", "future_columns": {"action": "include", "target_column": "{{ .Column }}"}, "write": {"mode": "append", "key_columns": []}}, "tables": []}]}
  }
}

{
  "config": {
    "ack_policy": "all",
    "table_mappings": {
      "destinations": [
        {
          "destination": "orders-postgres",
          "future_tables": {
            "action": "exclude"
          },
          "tables": [
            {
              "action": "include",
              "columns": [],
              "future_columns": {
                "action": "include",
                "target_column": "{{ .Column }}"
              },
              "source_schema": "public",
              "source_table": "orders",
              "target_schema": "public",
              "target_table": "orders",
              "write": {
                "key_columns": [
                  "id"
                ],
                "mode": "upsert"
              }
            }
          ]
        }
      ],
      "version": 2
    }
  },
  "destinations": [
    {
      "name": "orders-postgres",
      "postgres_destination": {
        "connection": {
          "dsn": "postgres://wallaby:wallaby@localhost:55432/destination?sslmode=disable"
        },
        "synchronous_commit": "on"
      }
    }
  ],
  "name": "quickstart-orders",
  "parallelism": 1,
  "source": {
    "name": "orders-source",
    "postgres_source": {
      "mode": "POSTGRES_SOURCE_MODE_CDC",
      "batch_size": 100,
      "batch_timeout": "0.250s",
      "connection": {
        "dsn": "postgres://wallaby:wallaby@localhost:55432/source?sslmode=disable"
      },
      "create_slot": true,
      "emit_empty": false,
      "ensure_publication": true,
      "publication": "wallaby_quickstart_pub",
      "publication_tables": [
        "public.orders"
      ],
      "slot": "wallaby_quickstart_slot",
      "sync_publication": true
    }
  },
  "wire_format": "json"
}

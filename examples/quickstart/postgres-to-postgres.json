{
  "name": "quickstart-orders",
  "wire_format": "json",
  "parallelism": 1,
  "source": {
    "name": "orders-source",
    "type": "postgres",
    "options": {
      "dsn": "postgres://wallaby:wallaby@localhost:55432/source?sslmode=disable",
      "slot": "wallaby_quickstart_slot",
      "publication": "wallaby_quickstart_pub",
      "publication_tables": "public.orders",
      "ensure_publication": "true",
      "sync_publication": "true",
      "create_slot": "true",
      "batch_size": "100",
      "batch_timeout": "250ms",
      "emit_empty": "false"
    }
  },
  "destinations": [
    {
      "name": "orders-postgres",
      "type": "postgres",
      "options": {
        "dsn":"postgres://wallaby:wallaby@localhost:55432/destination?sslmode=disable",
        "synchronous_commit":"on"
      }
    }
  ],
  "config": {
    "ack_policy":"all",
    "table_mappings":{"version":2,"destinations":[{"destination":"orders-postgres","future_tables":{"action":"exclude"},"tables":[{"source_schema":"public","source_table":"orders","action":"include","target_schema":"public","target_table":"orders","future_columns":{"action":"include","target_column":"{{ .Column }}"},"columns":[],"write":{"mode":"upsert","key_columns":["id"]}}]}]}
  }
}
